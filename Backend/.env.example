# ===========================
# Server
# ===========================
PORT=5000

# ===========================
# Database
# ===========================
# Paste your MongoDB Atlas connection string here (must start with mongodb+srv://)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eventra?retryWrites=true&w=majority

# Local fallback when Atlas IP whitelist blocks you (MongoDB service must be running)
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/eventra
# Set to true to always use local MongoDB instead of Atlas
USE_LOCAL_MONGO=false

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ===========================
# Email
# ===========================
# Use a Gmail App Password (not your normal password):
# https://myaccount.google.com/apppasswords
# Example account email for testing verification delivery:
# Register/login with your personal email; codes are sent FROM this business inbox:
EMAIL_USER=eventra.business.eg@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=Eventra
EMAIL_SERVICE=gmail

# Set to true to skip email verification (dev only). Default: verification required.
AUTO_VERIFY_EMAIL=false

# ===========================
# Client
# ===========================
CLIENT_URL=http://localhost:4200